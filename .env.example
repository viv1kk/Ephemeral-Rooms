# Machine-specific configuration for `docker compose`.
#
# Copy to `.env` and fill in. Compose reads `.env` from this directory
# automatically and substitutes the values into docker-compose.yml.
#
# `.env` is gitignored and `.env.example` is not - same arrangement as
# backend/.env.example, and for the same reason: real configuration, including
# the tunnel identity, never enters the repository. Keep this template in step
# whenever you add a variable.

# ----------------------------------------------------------- Cloudflare tunnel
#
# The tunnel's UUID, and the path to the credentials file that
# `cloudflared tunnel create` wrote. Both are printed by:
#
#     cloudflared tunnel list
#
# On Windows use forward slashes. Only this one JSON file is mounted into the
# container - never the whole ~/.cloudflared directory, because cert.pem in
# there is an account-wide credential that can create and delete tunnels, and
# `tunnel run` does not need it when the tunnel is named by UUID.
CF_TUNNEL_ID=00000000-0000-0000-0000-000000000000
CF_CREDENTIALS_FILE=C:/Users/you/.cloudflared/00000000-0000-0000-0000-000000000000.json

# ------------------------------------------------------------------ The app
#
# The public origin. With a tunnel in front this is the hostname you routed to
# it, over https.
PUBLIC_ORIGIN=https://rooms.example.com

# Safe to enable behind the tunnel: Cloudflare sets X-Forwarded-Proto to the
# scheme the visitor actually used, and Nginx passes it through untouched, so
# this only fires for a genuine plain-HTTP visitor. Set it to false if you are
# running the stack with no TLS in front (see the Docker section of README.md).
REDIRECT_HTTP_TO_HTTPS=true

# Host port for the local loopback published by the web container. The tunnel
# does not use it - it reaches Nginx over the compose network - so this is
# purely for checking the stack from this machine.
HTTP_PORT=8080

# --------------------------------------------------------- 10 GB room storage
#
# The ceiling is a real filesystem, not a setting: the backend's entrypoint
# mounts an ext4 image of this size at DATA_ROOT on every start, so the kernel
# returns ENOSPC past it and statvfs reports it - which is what the reservation
# ledger reads. Accepts anything truncate(1) does: 10G, 500M, 2T.
#
# Changing this does NOT resize an image that already exists. To resize:
# `docker compose down -v`, which discards it, then bring the stack back up.
ROOM_DISK_SIZE=10G

# The application's own ceiling, off because the filesystem is the ceiling.
# Set it only if you want a budget SMALLER than the filesystem - on a host
# where the data root is a shared volume you cannot size, for instance.
MAX_TOTAL_STORAGE_BYTES=0

# Stops the volume being filled to the very last byte, where the reaper and the
# cleanup paths would themselves have no room to work. Usable space is the
# image size minus this.
DISK_HEADROOM_BYTES=536870912

# So one room cannot swallow the whole disk. 0 = unlimited.
MAX_ROOM_TOTAL_BYTES=2147483648
