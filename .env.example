# Machine-specific configuration for `docker compose`.
#
# Copy to `.env` and fill in. Compose reads `.env` from this directory
# automatically and substitutes the values into docker-compose.yml.
#
# `.env` is gitignored and `.env.example` is not - same arrangement as
# backend/.env.example, and for the same reason: real configuration, including
# the tunnel identity, never enters the repository. Keep this template in step
# whenever you add a variable.

# ----------------------------------------------------------- Cloudflare tunnel
#
# The tunnel's UUID, and the path to the credentials file that
# `cloudflared tunnel create` wrote. Both are printed by:
#
#     cloudflared tunnel list
#
# On Windows use forward slashes. Only this one JSON file is mounted into the
# container - never the whole ~/.cloudflared directory, because cert.pem in
# there is an account-wide credential that can create and delete tunnels, and
# `tunnel run` does not need it when the tunnel is named by UUID.
CF_TUNNEL_ID=00000000-0000-0000-0000-000000000000
CF_CREDENTIALS_FILE=C:/Users/you/.cloudflared/00000000-0000-0000-0000-000000000000.json

# ------------------------------------------------------------------ The app
#
# The public origin. With a tunnel in front this is the hostname you routed to
# it, over https.
PUBLIC_ORIGIN=https://rooms.example.com

# Safe to enable behind the tunnel: Cloudflare sets X-Forwarded-Proto to the
# scheme the visitor actually used, and Nginx passes it through untouched, so
# this only fires for a genuine plain-HTTP visitor. Set it to false if you are
# running the stack with no TLS in front (see the Docker section of README.md).
REDIRECT_HTTP_TO_HTTPS=true

# Host port for the local loopback published by the web container. The tunnel
# does not use it - it reaches Nginx over the compose network - so this is
# purely for checking the stack from this machine.
HTTP_PORT=8080

# --------------------------------------------------------- 10 GB room storage
#
# The ceiling is a real filesystem, not a setting: the backend's entrypoint
# mounts an ext4 image of this size at DATA_ROOT on every start, so the kernel
# returns ENOSPC past it and statvfs reports it - which is what the reservation
# ledger reads. Accepts anything truncate(1) does: 10G, 500M, 2T.
#
# Changing this does NOT resize an image that already exists. To resize:
# `docker compose down -v`, which discards it, then bring the stack back up.
ROOM_DISK_SIZE=10G

# The application's own ceiling, off because the filesystem is the ceiling.
# Set it only if you want a budget SMALLER than the filesystem - on a host
# where the data root is a shared volume you cannot size, for instance.
MAX_TOTAL_STORAGE_BYTES=0

# Stops the volume being filled to the very last byte, where the reaper and the
# cleanup paths would themselves have no room to work. Usable space is the
# image size minus this.
DISK_HEADROOM_BYTES=536870912

# Per-room ceiling, off: a room may use whatever the disk has left, and the
# only thing that refuses an upload is DISK_HEADROOM_BYTES above. Set a byte
# count if you would rather cap each room.
MAX_ROOM_TOTAL_BYTES=0

# What DISK_HEADROOM_BYTES is to files, this is to document text - which lives
# in the backend process rather than on the disk, and so needs its own reserve.
# Editing is never blocked by it; the room is told the server is running low.
MEMORY_HEADROOM_BYTES=536870912

# The largest single WebSocket frame Uvicorn will assemble. One paste into the
# editor is one frame, so this is what bounds a single paste - the application
# imposes no limit of its own. Raise it if people paste more than 256 MiB at a
# time; the frame is buffered whole, so it costs memory while it arrives.
WS_MAX_FRAME_BYTES=268435456

# ----------------------------------------------------------- Docker Hub / CD
#
# Your Docker Hub account (or organisation) name. docker-compose.yml builds the
# image references from it, so no account name is hardcoded in the repository -
# the same rule the tunnel hostname follows. Required: compose fails with a
# message naming this variable if it is unset.
DOCKERHUB_NAMESPACE=your-dockerhub-username

# Credentials for the Watchtower container's registry polls. Optional for a
# public image, but anonymous pulls are rate-limited far more aggressively than
# authenticated ones, and hitting that limit looks exactly like "deployment
# quietly stopped working".
#
#   !!  Use a SEPARATE, READ-ONLY access token here - NOT the read/write one
#   !!  GitHub Actions pushes with. This container mounts the Docker socket,
#   !!  which is root-equivalent on this machine; a read-only token means a
#   !!  compromise of it still cannot publish a poisoned image to your account.
#
# Create at: Docker Hub -> Account Settings -> Personal access tokens
DOCKERHUB_USERNAME=your-dockerhub-username
DOCKERHUB_READ_TOKEN=

# Seconds between registry checks. Every check is a manifest request counting
# against Docker Hub's pull limit, so this is a rate-limit dial as much as a
# latency one. 900 (15 min) on one image is ~96 checks/day; do not lower it
# without reading the CD section of README.md.
WATCHTOWER_POLL_INTERVAL=900

# ------------------------------------------------------------- Pin / rollback
#
# Leave unset normally: compose then resolves the :latest tag that CI publishes,
# which is the tag Watchtower follows.
#
# Set one to a :sha- tag to pin that service to an exact commit - which is also
# how you roll back, and how you promote a new backend build:
#
#     BACKEND_IMAGE=your-name/ephemeral-rooms-backend:sha-<commit>
#     docker compose up -d backend
#
# Pinning a :sha- tag also takes that service out of Watchtower's reach, because
# an immutable tag's digest never changes - useful to freeze something while you
# investigate. Rolling the backend restarts it, which destroys every live room.
#
# BACKEND_IMAGE=
# WEB_IMAGE=
