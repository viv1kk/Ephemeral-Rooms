# Every environment variable the server reads, with its default.
#
# For production, copy to /etc/ephemeral-rooms.env (owned by root, mode 0640,
# group-readable by the service user) and edit. Settings are validated at
# startup, so a malformed value fails the process immediately rather than at
# the first request.

# ---------------------------------------------------------------- Deployment

# The public origin. No domain is hardcoded anywhere in the source.
PUBLIC_ORIGIN=https://example.com

# Where room files live. Must be writable by the service user, mode 0700.
# EVERYTHING under <DATA_ROOT>/rooms is deleted on startup: no room survives a
# restart, so its contents are by definition garbage (spec sections 15, 19).
DATA_ROOT=/var/lib/ephemeral-rooms

LOG_LEVEL=INFO

# Redirect plain HTTP to HTTPS when a proxy reports the browser is on HTTP.
# Inert unless X-Forwarded-Proto is present and says http, so it cannot affect
# local development or a direct connection, and it never fires behind the
# bundled Nginx because port 80 already redirects there. It matters for a
# proxy that forwards port 80 straight through - a Cloudflare tunnel without
# "Always Use HTTPS", for instance.
REDIRECT_HTTP_TO_HTTPS=true

# Serve the built frontend from Uvicorn as well. Leave unset in production;
# Nginx serves dist/ directly and never proxies static assets (spec section 30).
# SERVE_STATIC_DIR=/opt/ephemeral-rooms/frontend/dist

# --------------------------------------------------- Lifecycle (section 2.1)

# How often the server pings each socket. Must stay comfortably below Nginx's
# proxy_read_timeout, or idle sockets are cut before the first ping arrives.
WS_HEARTBEAT_INTERVAL_MS=20000

# No pong within this window terminates the socket. Must exceed the interval.
WS_HEARTBEAT_TIMEOUT_MS=45000

# A disconnected user stays in the presence list, dimmed, for this long. This
# is what makes a brief network blip not read as leaving.
USER_RECONNECT_GRACE_MS=30000

# An empty room is retained, with every document and file intact, for this long
# before it becomes unrecoverable. This is what makes browser refresh safe,
# including for a sole participant. Past it the room is destroyed and the code
# is released for reuse.
ROOM_EMPTY_GRACE_MS=60000

# ------------------------------------------------ Resource limits (21.3)

MAX_ROOMS=200
MAX_USERS_PER_ROOM=32
MAX_DOCS_PER_ROOM=50
MAX_DOC_BYTES=5242880
MAX_FILES_PER_ROOM=500

# 0 means unlimited; the effective limit is then free disk space.
MAX_FILE_BYTES=0
MAX_ROOM_TOTAL_BYTES=0

MAX_WS_MESSAGE_BYTES=1048576
MAX_DISPLAY_NAME_CHARS=32
MAX_DOC_NAME_CHARS=128
MAX_FILENAME_CHARS=255
MAX_UPLOADS_PER_USER=5

# ------------------------------------------------------- Storage (section 17)

# Never fill the volume to the point where the OS and logs are affected.
# Subtracted from the figure shown in the UI and from every reservation check.
DISK_HEADROOM_BYTES=2147483648

# Re-check actual free space this often during a transfer, to catch space
# consumed outside the application.
DISK_RECHECK_INTERVAL_BYTES=67108864

# Chunk size the browser is told to use.
UPLOAD_CHUNK_BYTES=8388608

# An upload with no activity for this long is reaped and its reservation
# released (layer 2 of the three-layer orphan prevention).
UPLOAD_STALE_MS=600000
REAPER_INTERVAL_MS=60000

# How often the available-storage figure is recomputed for the UI.
STORAGE_BROADCAST_INTERVAL_MS=15000
